# ── Server ────────────────────────────────────────────────────────────────────

# HTTP port the server listens on.
# Default: 3000
PORT=3000

# Deployment environment.  Controls CSRF enforcement, tracing exporter
# selection, and startup validation.
# Values: development | production | test
NODE_ENV=development

# Pino log level.  In "development" mode Pino uses a human-readable pretty
# format and ignores this variable.  In "production" it emits JSON at this
# level.
# Values: trace | debug | info | warn | error | fatal
# Default: info
LOG_LEVEL=info

# When set to "true", the server redirects all plain HTTP requests to HTTPS.
# Enable this on Render or any reverse-proxy deployment that terminates TLS
# externally and sets X-Forwarded-Proto.
# Default: false
FORCE_HTTPS=false


# ── TMDB (movie poster / metadata lookups) ────────────────────────────────────
#
# Both keys are optional.  When neither is set, poster lookups are skipped and
# candidate cards display a placeholder image.  Prefer the read-access token
# (v4 bearer auth) over the API key (v3 query-param auth) — set one or the
# other, not both.
#
# Obtain credentials at: https://www.themoviedb.org/settings/api

# v3 API key (query-param auth).  Use TMDB_API_READ_ACCESS_TOKEN instead where
# possible.
TMDB_API_KEY=

# v4 read-access token (bearer auth).  Takes precedence over TMDB_API_KEY.
TMDB_API_READ_ACCESS_TOKEN=


# ── Source poller ─────────────────────────────────────────────────────────────
#
# The poller scrapes Letterboxd, Reddit, and TheGamer on a schedule and writes
# the aggregate signal to data/source-signals.json, which the server streams to
# connected clients.

# Set to "true" to enable the background scraper process.
# Default: false (poller is disabled; run `npm run scrape:sources` manually)
ENABLE_SOURCE_POLLER=false

# How often the poller runs, in minutes.
# Minimum enforced value: 5.  Default: 30.
SOURCE_POLL_INTERVAL_MINUTES=30


# ── OpenTelemetry tracing ─────────────────────────────────────────────────────
#
# Tracing is opt-in.  Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable the
# SDK entirely (zero per-request overhead).
# In "development" with no endpoint set, spans are printed to stdout instead.

# Resource tag applied to every span.  Default: "oscar-odds"
OTEL_SERVICE_NAME=oscar-odds

# OTLP/HTTP collector endpoint.  Examples:
#   Local Jaeger (native OTLP since v1.35):  http://localhost:4318
#   Honeycomb:                               https://api.honeycomb.io
#   Grafana Tempo:                           http://localhost:4318
# When unset: ConsoleSpanExporter in development; SDK disabled in production.
OTEL_EXPORTER_OTLP_ENDPOINT=

# HTTP headers forwarded to the OTLP collector (comma-separated key=value).
# Required for Honeycomb:
#   x-honeycomb-team=<API_KEY>,x-honeycomb-dataset=oscar-odds
OTEL_EXPORTER_OTLP_HEADERS=

# Sampling strategy.  Default: parentbased_always_on (keep all spans).
# For high-traffic production deployments use "traceidratio" with a fractional
# OTEL_TRACES_SAMPLER_ARG (e.g. 0.1 = 10 % of root spans).
OTEL_TRACES_SAMPLER=parentbased_always_on

# Argument passed to the sampler above.  Only used by "traceidratio" and
# "parentbased_traceidratio".  Value must be a number in [0, 1].
OTEL_TRACES_SAMPLER_ARG=1
